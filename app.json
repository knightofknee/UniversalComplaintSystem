{
  "expo": {
    "name": "Universal Complaint System",
    "slug": "universal-complaint-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ucs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.waldgrave.ucs",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Lets you attach photos to a complaint.",
        "NSCameraUsageDescription": "Lets you take a photo to attach to a complaint."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:www.waldgrave.com"
      ]
    },
    "android": {
      "package": "com.waldgrave.ucs",
      "adaptiveIcon": {
        "backgroundColor": "#2346D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.waldgrave.com",
              "pathPrefix": "/ucs/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0E1117",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2346D8"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach photos to a complaint.",
          "cameraPermission": "Lets you take a photo to attach to a complaint."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/with-rnfirebase-no-spm.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73628e56-5158-4013-9591-721d5f784754"
      }
    },
    "owner": "knightofknee"
  }
}
