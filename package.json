{
  "name": "universal-complaint-system",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "emulators": "PATH=\"$(brew --prefix openjdk 2>/dev/null)/bin:$PATH\" firebase emulators:start",
    "review-claims": "tsx scripts/review-claims.ts",
    "remove": "tsx scripts/remove.ts",
    "export-web": "WEB_EXPORT=1 expo export --platform web --output-dir dist-web",
    "usage": "tsx scripts/usage.ts",
    "migrate": "tsx scripts/migrate.ts",
    "import": "tsx scripts/import.ts",
    "publish-web": "npm run export-web && rm -rf ../../Documents/GitHub/the-waldgrave/public/ucs/app && cp -R dist-web ../../Documents/GitHub/the-waldgrave/public/ucs/app",
    "reviewer": "tsx scripts/reviewer.ts"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.1",
    "@react-native-firebase/app-check": "^26.4.1",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native-firebase/app": {
      "firebase": "$firebase"
    }
  }
}
