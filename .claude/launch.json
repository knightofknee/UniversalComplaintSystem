{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "emulators",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "emulators"
      ],
      "port": 4010
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8096"
      ],
      "env": {
        "EXPO_PUBLIC_USE_EMULATORS": "1",
        "BROWSER": "none"
      },
      "port": 8096
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8093"
      ],
      "env": {
        "BROWSER": "none"
      },
      "port": 8093
    },
    {
      "name": "waldgrave",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "/Users/briancarlisle/Documents/GitHub/the-waldgrave",
        "next",
        "dev",
        "/Users/briancarlisle/Documents/GitHub/the-waldgrave",
        "-p",
        "3078"
      ],
      "env": {
        "CLAUDE_PREVIEW": "1"
      },
      "port": 3078
    }
  ]
}
