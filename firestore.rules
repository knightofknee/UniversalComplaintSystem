rules_version = '2';

// The public record is readable by anyone and writable by no client: every
// change goes through a Cloud Function, so counts, statuses, and the "seen"
// and "fixed" stats can't be forged. Organizations can respond (through
// functions) but never edit or remove anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // The person who runs UCS (functions/src/common.ts OPERATOR_EMAIL): reads the
    // operator queue (held organization requests, reports, AI spend).
    function isOperator() {
      return signedIn() && request.auth.token.email == "bricarlis@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function respondsFor(subjectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/subjects/$(subjectId)/responders/$(request.auth.uid));
    }

    match /subjects/{subjectId} {
      allow read: if resource.data.removed == false;
      // Who responds for an organization is not public.
      match /responders/{uid} {
        allow read: if isMe(uid);
      }
      // Private complaints: the organization and the author, nobody else.
      // Private counts (what private complaints are about) are the
      // organization's alone; who raised them is nobody's.
      match /privatePoints/{id} {
        allow read: if respondsFor(subjectId);
      }
      match /inbox/{threadId} {
        allow read: if respondsFor(subjectId) || (signedIn() && resource.data.uid == request.auth.uid);
        match /messages/{messageId} {
          allow read: if respondsFor(subjectId)
            || (signedIn()
              && get(/databases/$(database)/documents/subjects/$(subjectId)/inbox/$(threadId)).data.uid
                == request.auth.uid);
        }
      }
    }

    match /points/{pointId} {
      allow read: if resource.data.removed == false;
      match /responses/{responseId} {
        allow read: if true;
      }
      // Who supports what is private: you can see only your own support.
      match /supports/{uid} {
        allow read: if isMe(uid);
      }
      match /fixVotes/{uid} {
        allow read: if isMe(uid);
      }
      // Proposed fixes are public; who rated one, and how, is private.
      match /solutions/{solutionId} {
        allow read: if resource.data.removed == false;
        match /ratings/{uid} {
          allow read: if isMe(uid);
        }
      }
    }

    match /submissions/{submissionId} {
      allow read: if resource.data.removed == false;
      // Who voted a complaint "Best rant" is private: you can see only your own vote.
      match /loves/{uid} {
        allow read: if isMe(uid);
      }
    }

    // Public log of everything removed, and why.
    match /removals/{id} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if isMe(uid);
      match /mine/{submissionId} {
        allow read: if isMe(uid);
      }
      match /threads/{threadId} {
        allow read: if isMe(uid);
      }
      match /notifications/{id} {
        allow read: if isMe(uid);
        allow update: if isMe(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
      // Authors whose public complaints this person chose to hide (Block).
      match /blocks/{authorId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.at == request.time;
      }
    }

    match /claims/{claimId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isOperator();
    }

    match /reports/{id} {
      allow read: if isOperator();
    }
    // Pairs of points that may say the same thing, for the operator to merge.
    match /duplicates/{id} {
      allow read: if isOperator();
    }
    match /usage/{day} {
      allow read: if isOperator();
    }
    match /config/{id} {
      allow read: if isOperator();
    }

    // drafts, queue, rateLimits, authors, restricted, imports, pushTokenOwners: server only.
  }
}
